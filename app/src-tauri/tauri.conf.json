{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StatsMeister",
  "mainBinaryName": "StatsMeister",
  "version": "0.1.0",
  "identifier": "dev.statsmeister.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StatsMeister",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#131315"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "StatsMeister",
    "copyright": "© 2026 StatsMeister contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Телеметрия и разбор кругов для симрейсинга",
    "longDescription": "StatsMeister записывает телеметрию Assetto Corsa и ACC, импортирует реплеи AC и показывает, в каких поворотах уходит время и что сделать иначе.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
